<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" compressed="false"><diagram name="Pipeline v4" id="pipeline-v4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style=&quot;font-size:22px;&quot;&gt;Latent City Pipeline Map&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5C6B6D;&quot;&gt;DDPM urban vitality · pipeline v4 · 9 Sep 2026 · side-by-side nodes run in parallel · teal = action, amber = checkpoint, dashed = later&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1440" height="60" as="geometry" /></mxCell><mxCell id="bandA" value="&lt;b style=&quot;font-size:12px;&quot;&gt;STAGE A · Before any code&lt;/b&gt; &lt;font style=&quot;font-size:10px;color:#5C6B6D;&quot;&gt;· your first and second&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFE9;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1F6F8B;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1440" height="592" as="geometry" /></mxCell><mxCell id="bandB" value="&lt;b style=&quot;font-size:12px;&quot;&gt;STAGE B · Build the dataset&lt;/b&gt; &lt;font style=&quot;font-size:10px;color:#5C6B6D;&quot;&gt;· your third&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFE9;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1F6F8B;" vertex="1" parent="1"><mxGeometry x="40" y="752" width="1440" height="2904" as="geometry" /></mxCell><mxCell id="bandC" value="&lt;b style=&quot;font-size:12px;&quot;&gt;STAGE C · Pre-training analysis&lt;/b&gt; &lt;font style=&quot;font-size:10px;color:#5C6B6D;&quot;&gt;· your fourth&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFE9;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1F6F8B;" vertex="1" parent="1"><mxGeometry x="40" y="3696" width="1440" height="1606" as="geometry" /></mxCell><mxCell id="bandD" value="&lt;b style=&quot;font-size:12px;&quot;&gt;STAGE D · Train&lt;/b&gt; &lt;font style=&quot;font-size:10px;color:#5C6B6D;&quot;&gt;· your fifth&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFE9;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1F6F8B;" vertex="1" parent="1"><mxGeometry x="40" y="5342" width="1440" height="780" as="geometry" /></mxCell><mxCell id="bandE" value="&lt;b style=&quot;font-size:12px;&quot;&gt;STAGE E · Sample and analyze&lt;/b&gt; &lt;font style=&quot;font-size:10px;color:#5C6B6D;&quot;&gt;· your fifth and sixth&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFE9;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1F6F8B;" vertex="1" parent="1"><mxGeometry x="40" y="6162" width="1440" height="987" as="geometry" /></mxCell><mxCell id="bandF" value="&lt;b style=&quot;font-size:12px;&quot;&gt;STAGE F · Paper&lt;/b&gt; &lt;font style=&quot;font-size:10px;color:#5C6B6D;&quot;&gt;· your seventh, as future work&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEFE9;strokeColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#1F6F8B;" vertex="1" parent="1"><mxGeometry x="40" y="7189" width="1440" height="259" as="geometry" /></mxCell><mxCell id="A1" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;A1 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Write the indicator specification table&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;A footprint is a data source. Binary raster, density, and floor-area ratio are three different indicators of it.&lt;/li&gt;&lt;li&gt;Each row fixes subject, source, formula, measurement scale, ring scale, and expected sparsity.&lt;/li&gt;&lt;li&gt;The row count sets the channel count, so this comes before any loader change.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="164" width="300" height="219" as="geometry" /></mxCell><mxCell id="A2" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;A2 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Search for human-centric layers for HCMC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Your seventh stage: joint form and activity, the ISM proposal&amp;#x27;s original wording.&lt;/li&gt;&lt;li&gt;VIIRS night lights is the one layer known to be available, but at 500 m it is nearly flat inside a 1.2 km tile. Treat coarse layers as cell-level conditions, or find building-scale activity data.&lt;/li&gt;&lt;li&gt;Decides whether activity enters this paper or the next. The model no longer forces the choice.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="433" width="300" height="249" as="geometry" /></mxCell><mxCell id="A3" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;A3 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Move the raw HCMC vectors and the Python environment to the Linux box&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The 96 GB Pro 6000 is here. The OSM geopackages, grid, and venv are not.&lt;/li&gt;&lt;li&gt;The pilot&amp;#x27;s RGB cells need not come; the raw vectors must, since every channel is recomputed.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="433" width="300" height="249" as="geometry" /></mxCell><mxCell id="B1" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B1 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Cut the study area into zoom-15 map tiles (1,201 m)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;In generalization theory (Bonnaire et al.) the memorization onset grows linearly with sample count. Four times the tiles of zoom 14 widens the observable generalization window.&lt;/li&gt;&lt;li&gt;Typology is assigned per cell. 1.2 km cells are purer than 2.4 km cells, which keeps mutants clean.&lt;/li&gt;&lt;li&gt;Reversible: four zoom-15 tiles merge into one zoom-14 tile. Tile addressing standardizes other cities later.&lt;/li&gt;&lt;li&gt;Verified: 1,200 to 1,203 m across all of HCMC. No overlapping windows: near-duplicates corrupt the k-NN gap ratio.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="796" width="300" height="298" as="geometry" /></mxCell><mxCell id="B2" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B2 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Make the calculation unit equal to the pixel: 1024 px per tile, a 1.17 m unit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The unit is where an indicator&amp;#x27;s value is read, not where it is measured. Measurement scale belongs to each indicator: its decay radius, its ring, the polygon itself. So the unit is free above a floor set by the finest indicator, the footprints.&lt;/li&gt;&lt;li&gt;Your call, given HCMC&amp;#x27;s ground conditions: at 1.17 m a 3 m alley is two to three pixels wide and a 5 m rowhouse keeps its outline. The pilot&amp;#x27;s 50 m units under 7.8 m pixels broke the definition.&lt;/li&gt;&lt;li&gt;Cost grows with pixel count, not meaning: 64× the pilot&amp;#x27;s compute per step, so a 500K-step run is weeks by naive scaling. Debug at 128 or 256, calibrate at 512, run the experiments at 1024. Smaller mutants memorize sooner and need fewer steps.&lt;/li&gt;&lt;li&gt;At this size the noise schedule must be shifted and the U-Net needs more levels; Simple Diffusion (Hoogeboom et al. 2023) trained 1024 px in pixel space exactly this way. Reasoning drawn in the companion page.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="1144" width="300" height="451" as="geometry" /></mxCell><mxCell id="B3" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B3 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Buildings at 2 to 3 m: rasterize footprints, binary and density&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Rowhouses are 4 to 6 m wide and alleys 2 to 4 m. Coarser units fuse them into blocks.&lt;/li&gt;&lt;li&gt;The pilot&amp;#x27;s 150 m buffer coverage ratio flattened them to a scalar: Moran&amp;#x27;s I near 0.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1645" width="300" height="221" as="geometry" /></mxCell><mxCell id="B4" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B4 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Accessibility: gravity model on the road network, decay of a few hundred metres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Exponential decay yields a smooth field. Its meaning lives in the decay radius, so reading it at 2.35 m costs nothing and loses nothing.&lt;/li&gt;&lt;li&gt;It was the only pilot channel with spatial structure (Moran&amp;#x27;s I 0.25).&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="1645" width="300" height="221" as="geometry" /></mxCell><mxCell id="B5" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B5 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Diversity: Shannon entropy over a ring of a few hundred metres, plus POI count&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Entropy needs at least two POIs and two categories. At 50 m the pilot channel was 97.5 % zeros.&lt;/li&gt;&lt;li&gt;Count travels as its own channel, so diversity does not collapse into density.&lt;/li&gt;&lt;li&gt;Semantic categories only if OSM coverage holds up. The checkpoint below decides.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="1645" width="300" height="221" as="geometry" /></mxCell><mxCell id="B6" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B6 · CHECKPOINT&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Checkpoint: POI-per-ring coverage report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The fraction of units whose ring is non-degenerate must be high before any training.&lt;/li&gt;&lt;li&gt;You asked for this check explicitly.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FBF2E0;strokeColor=#B7791F;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="1916" width="300" height="140" as="geometry" /></mxCell><mxCell id="B7" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B7 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Resample every channel to the common pixel grid (Liu et al. 2024)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Each channel is computed at its natural scale first. Alignment happens only at the end.&lt;/li&gt;&lt;li&gt;Liu&amp;#x27;s image-to-image work fused independently rendered layers the same way.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="2106" width="300" height="155" as="geometry" /></mxCell><mxCell id="B8" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B8 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Store cells as multi-channel tensors, not RGB PNGs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The U-Net reads its channel count from the config; one channel or six both work. Only the PNG loader forces three.&lt;/li&gt;&lt;li&gt;No fusion step to defend, and activity layers become extra channels later.&lt;/li&gt;&lt;li&gt;Cost: no single picture of all channels, and no pretrained perceptual metric. FID and SSCD were already unusable on urban rasters.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="2311" width="300" height="276" as="geometry" /></mxCell><mxCell id="B9" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B9 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Decide how multi-channel cells will be shown&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Six greyscale grids cannot be one picture. Fix the conventions before the first sample exists: small multiples, one panel per channel; false-colour composites, any three channels to RGB, the remote-sensing habit; one perceptually uniform colour map per indicator.&lt;/li&gt;&lt;li&gt;Starting references, from memory, verify before citing: Tufte 1990, Envisioning Information, on small multiples; Crameri, Shephard and Heron 2020, Nature Communications, on colour maps; Munzner 2014, Visualization Analysis and Design, on encoding channels.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="2311" width="300" height="276" as="geometry" /></mxCell><mxCell id="B10" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B10 · CHECKPOINT&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Checkpoint: per-channel marginals, zero fraction, skew, tails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Chooses the transform for each channel.&lt;/li&gt;&lt;li&gt;Gaussianity is not required. The mixtures in the reference papers are solvable toy models, not data assumptions.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FBF2E0;strokeColor=#B7791F;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="2637" width="300" height="155" as="geometry" /></mxCell><mxCell id="B10b" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B10b · CHECKPOINT&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Checkpoint: the joint pattern of the six channels, as well as each one alone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Not a replacement for B10. Each channel&amp;#x27;s distribution across the whole city is its own finding, and stays one: it is what says whether an indicator is sparse, skewed, or flat, and it is what chooses the transform.&lt;/li&gt;&lt;li&gt;What it adds: six channels that each look right separately can still combine in ways the city never does, and nothing in a set of marginals can see that.&lt;/li&gt;&lt;li&gt;A unit&amp;#x27;s six numbers are one point in six-dimensional space. The real city occupies only part of that space: dense building with no shops is ordinary, high entropy with no POIs is impossible by construction. The occupied region is itself a structure the model can get right or wrong.&lt;/li&gt;&lt;li&gt;Same object as C3&amp;#x27;s clustering, which already treats a unit&amp;#x27;s column of scores as a point. This measures it as a distribution instead, so it can be compared against generated cells at E3.&lt;/li&gt;&lt;li&gt;Read it twice: in data space to say what the combinations mean, and in standardized space for anything using distance, since otherwise the widest channel decides which units are alike.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FBF2E0;strokeColor=#B7791F;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="2842" width="300" height="515" as="geometry" /></mxCell><mxCell id="B11" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;B11 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Transform, then standardize each channel; store the parameters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;A low-variance channel is pure noise over most of the diffusion trajectory. Standardization equalizes the signal-to-noise schedule across channels.&lt;/li&gt;&lt;li&gt;Sparse, heavy-tailed channels get log1p or a quantile map first.&lt;/li&gt;&lt;li&gt;The stored parameters are the decoder: unpacking a sample is just undoing this step.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="3407" width="300" height="219" as="geometry" /></mxCell><mxCell id="C1" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;C1 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Correlationist baseline: correlations among indicators across the study area&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The control condition the paper argues against, on the same data.&lt;/li&gt;&lt;li&gt;Not feature selection. The network handles correlated, non-linear inputs by itself.&lt;/li&gt;&lt;li&gt;Flags near-duplicate channels. Pilot diversity and accessibility correlated at 0.88.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="3740" width="300" height="206" as="geometry" /></mxCell><mxCell id="C2" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;C2 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Write the cell descriptor: one function for real and generated cells&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Per-channel mean, std, zero fraction, Moran&amp;#x27;s I, skewness; within-cell cross-channel correlation; unit-class composition.&lt;/li&gt;&lt;li&gt;Must be computable from the raster alone. Generated cells have no vectors behind them.&lt;/li&gt;&lt;li&gt;The pilot&amp;#x27;s statistics ran only on generated samples through separate code paths.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="3740" width="300" height="206" as="geometry" /></mxCell><mxCell id="C3" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;C3 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Typology: HDBSCAN on per-unit indicator vectors, then cell composition&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;DBSCAN needs only a vector and a distance. A unit&amp;#x27;s column of scores is one point, never split into one-hots.&lt;/li&gt;&lt;li&gt;Never on raw full-resolution tensors, where distance is meaningless. HDBSCAN handles varying density.&lt;/li&gt;&lt;li&gt;Typologies are the subspaces of Wang et al. That unifies intrinsic dimension, minimal set, and mutants.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="3996" width="300" height="234" as="geometry" /></mxCell><mxCell id="C4" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;C4 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Intrinsic dimension: global PCA k95, Levina-Bickel MLE, PCA inside each typology&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;PCA is linear and overestimates on curved manifolds. MLE follows curvature; the formula bug is fixed.&lt;/li&gt;&lt;li&gt;Wang et al. size the minimal set by per-subspace dimension.&lt;/li&gt;&lt;li&gt;The pilot&amp;#x27;s k95 of 33 was accessibility-dominated and must be re-estimated.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="4280" width="300" height="234" as="geometry" /></mxCell><mxCell id="C4b" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;C4b · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Map the real dataset in two dimensions, coloured by typology&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;PCA to about 50 numbers per cell first, then UMAP or t-SNE. One map for the whole stack and one per grid, fitted on real cells only.&lt;/li&gt;&lt;li&gt;Shows whether typologies separate and where the minimal set sits. It is the before picture, made before any model exists.&lt;/li&gt;&lt;li&gt;Use UMAP if generated cells must later land on this same map: UMAP can place new points on a fitted map, t-SNE cannot.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="4280" width="300" height="234" as="geometry" /></mxCell><mxCell id="C5" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;C5 · CHECKPOINT&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Checkpoint: does each typology sit in a low-dimensional subspace?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The Wang et al. assumption is a union of low-dimensional subspaces, a joint geometry, not marginal normality.&lt;/li&gt;&lt;li&gt;If not, revisit the clustering before sizing any dataset. Mirrored later by the denoiser&amp;#x27;s Jacobian rank.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FBF2E0;strokeColor=#B7791F;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="4564" width="300" height="185" as="geometry" /></mxCell><mxCell id="C6" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;C6 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Select the minimal baseline set by an explicit rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;PCA gives directions, not a subset. Use k-center greedy in PCA space or one representative per typology.&lt;/li&gt;&lt;li&gt;Sized per typology from C4.&lt;/li&gt;&lt;li&gt;Below the intrinsic-dimension threshold the model memorizes, so this set is the control where the generalization window should be short or absent.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="4799" width="300" height="219" as="geometry" /></mxCell><mxCell id="C7" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;C7 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;List the dataset mutants: baseline, +A, +B, −A, class-balanced, full&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The one place where correlationist and connectionist views can disagree.&lt;/li&gt;&lt;li&gt;Invariants across mutants are the irreducible structure.&lt;/li&gt;&lt;li&gt;Each mutant gets its own model size and steps, because the memorization onset scales with n. Hypotheses H1 to H4 from June.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="5068" width="300" height="204" as="geometry" /></mxCell><mxCell id="D1" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;D1 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Train the DDPM directly on the cell tensors, with no latent space&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Noise is added to the indicator grids themselves, so what the model memorizes or generalizes is measured in the data, not in a black box. A learned VAE latent would move it there and impose natural-image priors.&lt;/li&gt;&lt;li&gt;&amp;quot;Pixel&amp;quot; here means unit, not colour. The tensor is C grids of unit scores; see the companion page.&lt;/li&gt;&lt;li&gt;Model size and steps per mutant follow from the memorization onset scaling with n. At 1024 px the noise schedule must be shifted and the U-Net needs more levels.&lt;/li&gt;&lt;li&gt;Runs on the Pro 6000 once A3 is done.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="5386" width="300" height="298" as="geometry" /></mxCell><mxCell id="D2" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;D2 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Score F_mem on an untrained model to get the metric&amp;#x27;s noise floor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Random weights produce nonsense cells. Whatever memorization fraction they score is the floor; only values above it mean the trained model copied.&lt;/li&gt;&lt;li&gt;Independent of encoding, so it survives the redesign. Feeds the onset threshold in E4.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="5386" width="300" height="298" as="geometry" /></mxCell><mxCell id="D3" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;D3 · CHECKPOINT&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Checkpoint: locate the memorization onset on one short run first&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Every mutant is its own multi-day run, and the step budget only makes sense once tau_mem is known for this data. Guessing it wastes the budget in whichever direction the guess is wrong.&lt;/li&gt;&lt;li&gt;Measured on the Pro 6000: a 500K-step run at 1024 px is 4 to 8 days. Sizing four mutants from a guess risks a month.&lt;/li&gt;&lt;li&gt;The dataset is small. Of 1,881 zoom-15 tiles only 617 hold any building and 139 hold a hundred or more, and generalization theory has the onset growing with sample count, so the window may open and close early here.&lt;/li&gt;&lt;li&gt;Run one mutant with logarithmic checkpoints until F_mem clears the D2 noise floor, then set every other run&amp;#x27;s budget from where that happened.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FBF2E0;strokeColor=#B7791F;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="5734" width="300" height="358" as="geometry" /></mxCell><mxCell id="E1" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;E1 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Sample every checkpoint; undo the standardization&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;A sample is a tensor in data space, not an embedding.&lt;/li&gt;&lt;li&gt;Unpacking is the stored shift and scale in reverse, plus an optional three-grid rendering for humans.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="6206" width="300" height="170" as="geometry" /></mxCell><mxCell id="E2" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;E2 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Memorization: k-NN gap ratio on the standardized tensors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Raw distance is dominated by the highest-variance channel. The pilot measured accessibility memorization.&lt;/li&gt;&lt;li&gt;The descriptor is too coarse to detect copying of a specific cell.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="6426" width="300" height="281" as="geometry" /></mxCell><mxCell id="E3" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;E3 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Distribution: descriptor on real vs generated, per mutant, per checkpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Same function on both sides.&lt;/li&gt;&lt;li&gt;Irreducible characteristics: invariant across mutants and stable through the generalization window.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="6426" width="300" height="281" as="geometry" /></mxCell><mxCell id="E3b" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;E3b · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Put generated cells on the real dataset&amp;#x27;s 2-D map, per grid and per checkpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Same PCA and UMAP fitted in C4b, so real and generated points share one map. Where generated points fill, avoid, or pile onto real ones shows what each grid learned.&lt;/li&gt;&lt;li&gt;Per grid isolates which indicator&amp;#x27;s distribution drifted. Repeated over checkpoints it becomes a film of the generalization window.&lt;/li&gt;&lt;li&gt;Qualitative: distances on such a map are not measurements. The descriptor histograms and Wasserstein distances carry the numbers.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="6426" width="300" height="281" as="geometry" /></mxCell><mxCell id="E3c" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;E3c · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Spatial relations between grids: real versus generated, before and after training&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Within a cell, how the grids sit relative to each other in space: bivariate Moran&amp;#x27;s I between two grids, co-location of unit classes, cross-correlograms by distance.&lt;/li&gt;&lt;li&gt;The pilot&amp;#x27;s synergy analysis compared cell-level averages, which cannot tell whether buildings sit on accessible units or merely share a cell with them.&lt;/li&gt;&lt;li&gt;Computed once on real cells and at every checkpoint on generated cells, so the change reads from what to what.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="6426" width="300" height="281" as="geometry" /></mxCell><mxCell id="E4" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;E4 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Locate the window per mutant: structure onset to memorization onset above the noise floor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Structure onset from E3, E3b and E3c; memorization onset from E2, above the D2 floor.&lt;/li&gt;&lt;li&gt;Disclose thresholds. The pilot&amp;#x27;s coupled threshold |r| &amp;gt; 0.5 moved the boundary.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610" y="6757" width="300" height="172" as="geometry" /></mxCell><mxCell id="E5" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;E5 · LATER&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Jacobian rank of the trained denoiser (Hutchinson estimator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;Model-side test of the subspace structure from C5.&lt;/li&gt;&lt;li&gt;Full SVD is infeasible at this size.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#F4F6F3;strokeColor=#7F8D8F;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="610" y="6979" width="300" height="140" as="geometry" /></mxCell><mxCell id="F1" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;F1 · ACTION&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Contrast the correlationist baseline with the mutant invariants&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The falsifiable claim: features invariant across mutants and stable through the generalization window are structure. Correlation importance is the comparison.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#FFFFFF;strokeColor=#1F6F8B;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="7233" width="300" height="185" as="geometry" /></mxCell><mxCell id="F2" value="&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;F2 · LATER&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Joint form + activity run with extra channels&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5C6B6D;&quot;&gt;WHY&lt;/font&gt;&lt;ul style=&quot;margin:2px 0 0 14px;padding:0;&quot;&gt;&lt;li&gt;The ISM proposal&amp;#x27;s original wording. Depends on A2.&lt;/li&gt;&lt;li&gt;No architecture change: activity layers are more channels. Conditional sampling then answers &amp;quot;given this form, what activity?&amp;quot; directly.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=8;fillColor=#F4F6F3;strokeColor=#7F8D8F;strokeWidth=1.5;fontSize=11;fontColor=#1B2426;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="7233" width="300" height="185" as="geometry" /></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C8B8D;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C8B8D;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A1" target="A3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C8B8D;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="B1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C8B8D;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A3" target="B1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C8B8D;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="B1" target="B2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C8B8D;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="B2" target="B3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C8B8D;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx